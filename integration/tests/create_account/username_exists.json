{
  "description": "Create account rejects duplicate usernames",
  "mode": "script",
  "clients": {
    "player": "localhost:4000",
    "player2": "localhost:4000"
  },
  "script": [
    { "client": "player", "fn": "expect", "text": "Welcome" },
    { "client": "player", "fn": "send", "text": "create" },
    { "client": "player", "fn": "expect", "text": "username" },
    { "client": "player", "fn": "send", "text": "bobby" },
    { "client": "player", "fn": "expect", "text": "password" },
    { "client": "player", "fn": "send", "text": "passw" },
    { "client": "player", "fn": "expect", "text": "Confirm" },
    { "client": "player", "fn": "send", "text": "passw" },
    { "client": "player", "fn": "expect", "text": "created" },

    { "client": "player2", "fn": "expect", "text": "Welcome" },
    { "client": "player2", "fn": "send", "text": "create" },
    { "client": "player2", "fn": "expect", "text": "username" },
    { "client": "player2", "fn": "send", "text": "bobby" },
    { "client": "player2", "fn": "expect", "text": "already in use" }
  ]
}

